# Kopiera till .env och fyll i. Committa ALDRIG den ifyllda filen.

# ── Supabase ──────────────────────────────────────────────────────────────
# Service-nyckeln går förbi row level security helt. Den ska bara finnas på
# servern, aldrig i klientkoden och aldrig i repot.
SUPABASE_URL=https://ditt-projekt.supabase.co
SUPABASE_SERVICE_KEY=

# ── Sessioner ─────────────────────────────────────────────────────────────
# Signerar admin-tokens. Läcker den kan vem som helst utfärda en giltig
# admin-token och läsa all kunddata. Generera en ny med:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── Första admin-kontot ───────────────────────────────────────────────────
# Läses bara när kontot skapas första gången.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY=

# ── Push-notiser (VAPID) ──────────────────────────────────────────────────
# Generera ett par med: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── AI-avläsning av leverantörsfakturor ───────────────────────────────────
# Utan den här är fakturaimporten avstängd; resten av appen fungerar.
ANTHROPIC_API_KEY=

# ── Valutakurser ──────────────────────────────────────────────────────────
# Valfria. RIKSBANK_API pekas bara om vid test eller om källan byts ut.
# FX_FALLBACK_RATE används när kursen inte går att hämta — och exporten
# märks då tydligt som ej bokföringsduglig.
# RIKSBANK_API=https://api.riksbank.se/swea/v1
# FX_FALLBACK_RATE=11

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
